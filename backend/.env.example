# Supabase credentials for the API runtime (both Node local dev and
# `wrangler dev` via .dev.vars). On Cloudflare, set these with:
#   wrangler secret put SUPABASE_URL
#   wrangler secret put SUPABASE_ANON_KEY
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key"

# Local Node port (src/index.ts only)
PORT=3001

# Direct Postgres connection string — drizzle-kit tooling ONLY
# (db:push / db:migrate / db:seed / update-colors). The request runtime
# uses Supabase REST, never this.
# Supabase connection details can be found in the settings for the database
DATABASE_URL="postgresql://postgres.$SUPABASE_URL:$SUPABASE_URL_PASSWORD@$SUPABASE_SERVER_URL:6543/postgres"
